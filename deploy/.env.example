# Copy to .env next to compose.yaml (docker compose reads it automatically). Never commit .env.

# Run the tailscale sidecar (HTTPS on the tailnet). Leave it out for plain HTTP only (local testing).
COMPOSE_PROFILES=tailnet

# Pre-auth key from https://login.tailscale.com/admin/settings/keys (only needed for the first start).
TS_AUTHKEY=tskey-auth-REPLACE_ME
# The machine name: the game is then at https://yarg.<your-tailnet>.ts.net
TS_HOSTNAME=yarg
# Optional, e.g. --advertise-tags=tag:yarg (the tag must exist in the tailnet policy, see README.md)
TS_EXTRA_ARGS=

# Folder with the WebGL build (index.html, Build/, StreamingAssets/, TemplateData/), copied there by hand
YARG_WEB_BUILD=./volume/web

# Plain HTTP port on the host. 127.0.0.1 keeps it off the network; the tailnet goes through the sidecar.
YARG_HTTP_BIND=127.0.0.1
YARG_HTTP_PORT=8080
